{
    "version": "3.0.0",
    "description": "Financial data detection rules",
    "rules": [
        {
            "id": "CARD",
            "name": "Credit/debit card numbers",
            "pattern": "\\b\\d{4}-\\d{4}-\\d{4}-\\d{4}\\b|\\b\\d{4} \\d{4} \\d{4} \\d{4}\\b|\\b\\d{13,16}\\b",
            "flags": "g",
            "type": "financial",
            "severity": "critical",
            "validator": "luhn",
            "confidence": 0.9
        },
        {
            "id": "BANK_ACCOUNT",
            "name": "IBAN bank account numbers",
            "pattern": "\\b[A-Z]{2}\\d{2}[A-Z0-9]{11,30}\\b",
            "flags": "gi",
            "type": "financial",
            "severity": "critical",
            "validator": "bank_account",
            "confidence": 0.9
        },
        {
            "id": "MPESA",
            "name": "M-Pesa reference codes",
            "pattern": "\\b[A-Z0-9]{10}\\b",
            "flags": "g",
            "type": "financial",
            "severity": "low",
            "validator": "mpesa",
            "confidence": 0.8
        }
    ]
}
