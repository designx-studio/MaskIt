{
  "name": "maskit-extension",
  "version": "2.4.0",
  "private": true,
  "description": "Local protection for sensitive data on supported AI surfaces (browser, CLI, MCP, Windows clipboard).",
  "scripts": {
    "test": "node test.js && node defaults-sync-test.js && node engine/test.js && node mcp-server/test.js && node parity-test.js && node tests/copilot/copilot-editor.test.js && node tests/file-upload/file-context.test.js && node tests/agent/configuration.test.js && node tests/agent/health-endpoint.test.js && node tests/vscode/vscode-extension.test.js",
    "test:docs": "node scripts/verify-doc-consistency.js",
    "test:regex": "node scripts/validate-regex-safety.js",
    "test:browser-surface": "node scripts/validate-browser-surface.js",
    "test:stabilization": "node scripts/validate-stabilization.js",
    "test:canonical-events": "node scripts/verify-canonical-events.js",
    "test:adapter-events": "node scripts/verify-adapter-events.js",
    "test:release-artifacts": "node scripts/verify-release-artifacts.js",
    "test:clean-install": "node scripts/verify-clean-install.js",
    "test:windows-package": "node scripts/verify-windows-package.js",
    "test:e2e:chromium": "node scripts/e2e-chromium.js",
    "test:parity:adapters": "node parity-test.js && node scripts/verify-adapter-events.js",
    "test:cross-adapter-parity": "node scripts/verify-cross-adapter-parity.js",
    "check:browser-artifact": "node scripts/check-browser-artifact.js",
    "audit:website": "node scripts/audit-website.js",
    "release:monitor": "node scripts/release-monitor.js",
    "build": "node scripts/build.js",
    "build:windows": "node scripts/build-windows-agent.js",
    "build:chrome": "node scripts/build.js chrome",
    "build:firefox": "node scripts/build.js firefox",
    "build:edge": "node scripts/build.js edge",
    "build:opera": "node scripts/build.js opera",
    "preview": "node mcp-server/http-server.js",
    "icons": "node scripts/generate-icons.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "version:bump": "node scripts/bump-version.js",
    "test:engine": "node engine/test.js",
    "test:extension": "node test.js",
    "test:mcp": "node mcp-server/test.js",
    "test:parity": "node parity-test.js"
  },
  "devDependencies": {
    "playwright": "1.49.1",
    "safe-regex": "^2.1.1"
  }
}
